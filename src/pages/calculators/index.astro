---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../layouts/SiteNav.astro';
import SiteFooter from '../../layouts/SiteFooter.astro';
import SearchableListIsland from '../../components/SearchableListIsland';
import { getAllCalculators, getCalculatorsByVertical, getHubVerticals } from '../../calculators/registry';
import { CATEGORY_LABELS, VERTICALS, type Vertical } from '../../calculators/registry/types';

const BASE_URL = 'https://calcengine.site';
const calculators = getAllCalculators();
const hubs = getHubVerticals();
const sections = (Object.keys(VERTICALS) as Vertical[])
  .map((v) => ({ v, info: VERTICALS[v], items: getCalculatorsByVertical(v), hasHub: hubs.includes(v) }))
  .filter((s) => s.items.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All Free Online Calculators — CalcEngine',
  description: 'Browse every CalcEngine calculator: business and seller fees, math, electrical and energy, and developer tools.',
  url: `${BASE_URL}/calculators`,
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: calculators.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.meta.title,
      url: `${BASE_URL}/calculators/${c.meta.slug}`,
    })),
  },
};
---

<BaseLayout
  title="All Free Online Calculators — Business, Electrical, Math & Developer | CalcEngine"
  description="Browse every CalcEngine calculator: PayPal and Stripe fees, markup, commission, weighted average, wire size, amps, energy cost, and developer tools. No sign-up needed."
  canonical="/calculators"
  jsonLd={jsonLd}
  ogImage={`${BASE_URL}/og/home.png`}
>
  <SiteNav />

  <!-- Static header — visible to crawlers immediately -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-2">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">All Calculators</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-6">
      Every calculator, grouped by category. Each one shows its formula, assumptions and worked examples.
    </p>
  </div>

  <!-- Static list — rendered in HTML for crawlers and no-JS users.
       Hidden by SearchableListIsland on mount once React is ready. -->
  <div id="static-calc-list" class="max-w-3xl mx-auto px-4 sm:px-6 pb-12">
    {sections.map((sec) => (
    <section aria-label={`${sec.info.label} calculators`} class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">
      {sec.hasHub ? <a href={`/calculators/${sec.v}`} class="hover:text-[#1565c0] dark:hover:text-[#42a5f5] no-underline">{sec.info.label}</a> : sec.info.label}
    </h2>
    <ul class="space-y-2 list-none">
    {sec.items.map((c) => (
      <li>
        <a
          href={`/calculators/${c.meta.slug}`}
          class="flex justify-between items-start border border-gray-200 dark:border-gray-800 rounded-xl p-4 bg-white dark:bg-[#141414] hover:shadow-md dark:hover:border-gray-600 transition-all no-underline"
        >
          <div>
            <p class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{c.meta.shortTitle}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">{c.meta.description}</p>
          </div>
          <span class="ml-3 flex-shrink-0 text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 px-2.5 py-1 rounded-full">
            {CATEGORY_LABELS[c.meta.category]}
          </span>
        </a>
      </li>
    ))}
    </ul>
    </section>
    ))}
  </div>

  <!-- Interactive island — search + filter. Hidden until React mounts, then swaps with static list. -->
  <div id="react-calc-island" style="display:none" class="max-w-3xl mx-auto px-4 sm:px-6 pb-12">
    <SearchableListIsland client:only="react" />
  </div>

  <SiteFooter />
</BaseLayout>
