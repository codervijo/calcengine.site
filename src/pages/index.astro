---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../layouts/SiteNav.astro';
import SiteFooter from '../layouts/SiteFooter.astro';
import { getCalculatorBySlug, getCalculatorsByVertical, getHubVerticals } from '../calculators/registry';
import { VERTICALS, type Vertical } from '../calculators/registry/types';
import { buildWebAppJsonLd, buildOrganizationJsonLd, buildWebSiteJsonLd } from '../seo/jsonLd';

const BASE_URL = 'https://calcengine.site';

// Featured calculators — the v2 demand-validated set (see docs/seo-experiments.md).
const FEATURED = [
  'markup-calculator',
  'paypal-fee-calculator',
  'weighted-average-calculator',
  'wire-size-calculator',
  'commission-calculator',
  'stripe-fee-calculator',
];
const featured = FEATURED.map((s) => getCalculatorBySlug(s)).filter((c) => c !== undefined);

// Developer vertical highlights (pre-v2 pages kept as one vertical among several).
const DEV_HIGHLIGHTS = ['openai-cost-calculator', 'json-size-calculator', '429-too-many-requests-calculator', 'littles-law-calculator'];
const devHighlights = DEV_HIGHLIGHTS.map((s) => getCalculatorBySlug(s)).filter((c) => c !== undefined);

const hubs = getHubVerticals();
const verticalOrder = (Object.keys(VERTICALS) as Vertical[]).filter((v) => v !== 'developer');
const sections = verticalOrder
  .map((v) => ({ v, info: VERTICALS[v], items: getCalculatorsByVertical(v), hasHub: hubs.includes(v) }))
  .filter((s) => s.items.length > 0);
const devCount = getCalculatorsByVertical('developer').length;

const jsonLd = [
  buildWebAppJsonLd(
    'CalcEngine',
    'Free online calculators with open formulas: payment fees, markup and commission, weighted averages, wire size, amps and energy cost, plus developer tools.',
    BASE_URL,
    `${BASE_URL}/og/home.png`,
  ),
  buildOrganizationJsonLd(),
  buildWebSiteJsonLd(),
];

const features = [
  { title: 'Formulas shown', desc: 'Every calculator shows the formula it uses and works through real examples.' },
  { title: 'Sources and dates', desc: 'Fee schedules and code tables name their source and the date we last checked them.' },
  { title: 'Clear limits', desc: 'Each page says what it assumes and what it does not model, so you know when to dig deeper.' },
  { title: 'Free, no sign-up', desc: 'Calculations run in your browser. No account, no paywall.' },
];
---

<BaseLayout
  title="CalcEngine — Free Calculators for Fees, Markup, Wire Size & More"
  description="Free online calculators with the formula shown: PayPal and Stripe fees, markup, commission, weighted average, wire size, amps, energy cost and developer tools."
  canonical="/"
  jsonLd={jsonLd}
  ogImage={`${BASE_URL}/og/home.png`}
>
  <SiteNav />

  <!-- Hero -->
  <section aria-label="Hero" class="bg-[#1565c0] text-white py-14 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-4 leading-tight">
        Free Calculators That Show Their Working
      </h1>
      <p class="text-lg sm:text-xl opacity-90 mb-8 font-normal">
        Payment fees, pricing, everyday math, electrical sizing and energy cost — each with the formula,
        the assumptions and a worked example.
      </p>
      <a href="/calculators" class="inline-flex items-center gap-2 bg-white text-[#1565c0] font-semibold px-8 py-3 rounded-lg hover:bg-gray-100 transition-colors no-underline text-base">
        Browse All Calculators
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- Featured -->
  <section aria-label="Popular calculators" class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 dark:text-gray-100 text-center mb-8">
      Popular Calculators
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map((c) => (
        <a href={`/calculators/${c.meta.slug}`} class="block border border-gray-200 dark:border-gray-800 rounded-xl p-5 bg-white dark:bg-[#141414] hover:shadow-md dark:hover:border-gray-600 transition-all no-underline">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1.5">{c.meta.title}</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">{c.meta.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section aria-label="Calculator categories" class="bg-gray-50 dark:bg-[#0f0f0f] py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 dark:text-gray-100 text-center mb-10">Calculators by Category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {sections.map((sec) => (
          <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-[#141414] p-5">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">
              {sec.hasHub
                ? <a href={`/calculators/${sec.v}`} class="hover:text-[#1565c0] dark:hover:text-[#42a5f5] no-underline">{sec.info.label}</a>
                : sec.info.label}
            </h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">{sec.info.blurb}</p>
            <ul class="space-y-1.5 list-none">
              {sec.items.map((c) => (
                <li><a href={`/calculators/${c.meta.slug}`} class="text-[#1565c0] dark:text-[#42a5f5] text-sm hover:underline">{c.meta.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-[#141414] p-5">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">
            <a href="/calculators/developer" class="hover:text-[#1565c0] dark:hover:text-[#42a5f5] no-underline">{VERTICALS.developer.label}</a>
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">{VERTICALS.developer.blurb}</p>
          <ul class="space-y-1.5 list-none">
            {devHighlights.map((c) => (
              <li><a href={`/calculators/${c.meta.slug}`} class="text-[#1565c0] dark:text-[#42a5f5] text-sm hover:underline">{c.meta.title}</a></li>
            ))}
            <li><a href="/calculators/developer" class="text-gray-600 dark:text-gray-400 text-sm hover:underline">All {devCount} developer calculators →</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why CalcEngine -->
  <section aria-label="Why CalcEngine" class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 dark:text-gray-100 text-center mb-10">
      Why CalcEngine?
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {features.map((f) => (
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{f.title}</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">{f.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/calculators" class="inline-flex items-center gap-2 bg-[#1565c0] dark:bg-[#42a5f5] text-white font-semibold px-8 py-3 rounded-lg hover:bg-[#0d47a1] dark:hover:bg-[#1565c0] transition-colors no-underline">
        View All Calculators
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>
